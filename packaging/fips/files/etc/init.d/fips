#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
    [ -s /etc/fips/fips.yaml ] || return 0
    [ -s /etc/fips/router/settings.json ] || return 0
    jsonfilter -i /etc/fips/router/settings.json -e '@.enabled' | grep -qx true || return 0
    mkdir -p /run/fips
    chmod 0700 /run/fips
    procd_open_instance
    procd_set_param command /usr/bin/fips --config /etc/fips/fips.yaml
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    restart
}
