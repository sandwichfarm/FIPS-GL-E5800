#!/bin/sh /etc/rc.common
# Optional LAN gateway. Settings are generated by fips-router-admin as JSON.
USE_PROCD=1
START=96
STOP=09

ROOT=${FIPS_TEST_FS_ROOT:-}
SETTINGS="$ROOT/etc/fips/router/settings.json"
STATE="$ROOT/etc/fips/router/gateway-state"
PROC="$ROOT/proc/sys/net/ipv6/conf/all"
BOOT_ID="$ROOT/proc/sys/kernel/random/boot_id"
GATEWAY="$ROOT/usr/bin/fips-gateway"
ADMIN="$ROOT/usr/bin/fips-router-admin"
FIPS_CONFIG="$ROOT/etc/fips/fips.yaml"
ODHCPD="$ROOT/etc/init.d/odhcpd"
DNSMASQ="$ROOT/etc/init.d/dnsmasq"
DNS_DAEMON='/fips/::1#5354'
DNS_GATEWAY='/fips/::1#5365'

gateway_enabled() {
    [ -s "$SETTINGS" ] &&
        [ "$(jsonfilter -i "$SETTINGS" -e '@.enabled' 2>/dev/null)" = true ] &&
        [ "$(jsonfilter -i "$SETTINGS" -e '@.gateway_enabled' 2>/dev/null)" = true ]
}

has_dns() {
    case " $(uci -q get 'dhcp.@dnsmasq[0].server' 2>/dev/null) " in
        *" $1 "*) return 0;;
        *) return 1;;
    esac
}

route_source() {
    mac=$(cat "$ROOT/sys/class/net/br-lan/address") || return 1
    [ "${#mac}" -eq 17 ] || return 1
    case "$mac" in *[!0-9A-Fa-f:]*) return 1;; esac
    # A domain-separated MAC digest gives this service a stable, distinct
    # link-local source. It must not share odhcpd's RA source address.
    digest=$(printf 'fips-route:%s' "$mac" | sha256sum | cut -c1-16) || return 1
    [ "${#digest}" -eq 16 ] || return 1
    printf 'fe80::%s:%s:%s:%s\n' \
        "$(printf '%s' "$digest" | cut -c1-4)" \
        "$(printf '%s' "$digest" | cut -c5-8)" \
        "$(printf '%s' "$digest" | cut -c9-12)" \
        "$(printf '%s' "$digest" | cut -c13-16)"
}

start_service() {
    if ! gateway_enabled; then
        if [ -d "$STATE" ]; then
            stop_service || return 1
            # rc.common invokes these only for a real stop, not for a repeated
            # start that disables the gateway.
            ubus call service delete '{"name":"fips-gateway"}' >/dev/null 2>&1 || true
            service_stopped || return 1
        fi
        return 0
    fi
    [ -x "$GATEWAY" ] && [ -x "$ADMIN" ] || return 1
    # This integration relies on LAN clients already using this router as
    # their IPv6 default gateway. Never force a default RA on IPv4-only WANs.
    ip -6 route show default | grep -q . || return 1
    case "$(uci -q get dhcp.lan.ra 2>/dev/null)" in
        server|relay|hybrid) ;;
        *) return 1 ;;
    esac
    # Clients need a SLAAC-capable LAN prefix for a routable source address.
    # RA service alone does not prove such a prefix exists.
    ip -6 -o addr show dev br-lan scope global | grep -Eq ' inet6 [0-9A-Fa-f:]+/64 ' || return 1
    if [ -d "$STATE" ]; then
        stop_service || return 1
        ubus call service delete '{"name":"fips-gateway"}' >/dev/null 2>&1 || true
        service_stopped || return 1
    fi
    mkdir -p "$STATE" "$ROOT/run/fips" || return 1
    chmod 0700 "$STATE" "$ROOT/run/fips"
    # Record only values this service changes. A restart first undoes its own
    # previous changes; unrelated LAN settings remain untouched.
    cat "$PROC/forwarding" > "$STATE/forwarding" || return 1
    cat "$PROC/proxy_ndp" > "$STATE/proxy-ndp" || return 1
    cat "$BOOT_ID" > "$STATE/boot-id" || return 1
    has_dns "$DNS_DAEMON" && : > "$STATE/daemon-dns-present"
    has_dns "$DNS_GATEWAY" && : > "$STATE/gateway-dns-present"

    ra_source=$(route_source) || return 1
    if ip -6 -o addr show dev br-lan scope link | grep -Fq " $ra_source/64 "; then
        return 1
    fi
    printf '%s\n' "$ra_source" > "$STATE/ra-address" || return 1
    ip -6 addr add "$ra_source/64" dev br-lan || return 1
    attempts=0
    while [ "$attempts" -lt 5 ]; do
        ra_line=$(ip -6 -o addr show dev br-lan scope link | grep -F " $ra_source/64 " || true)
        case "$ra_line" in
            *dadfailed*) return 1;;
            ''|*tentative*) ;;
            *) break;;
        esac
        attempts=$((attempts + 1))
        sleep 1
    done
    [ "$attempts" -lt 5 ] || return 1

    sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null || return 1
    sysctl -w net.ipv6.conf.all.proxy_ndp=1 >/dev/null || return 1
    modprobe nf_conntrack 2>/dev/null || true
    if has_dns "$DNS_DAEMON"; then
        uci -q del_list "dhcp.@dnsmasq[0].server=$DNS_DAEMON" || return 1
    fi
    if ! has_dns "$DNS_GATEWAY"; then
        uci add_list "dhcp.@dnsmasq[0].server=$DNS_GATEWAY" || return 1
    fi
    uci commit dhcp || return 1
    "$ODHCPD" restart || return 1
    "$DNSMASQ" restart || return 1
    procd_open_instance gateway
    procd_set_param command "$GATEWAY" --config "$FIPS_CONFIG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    procd_open_instance route
    procd_set_param command "$ADMIN" --advertise-route "$ra_source"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    [ -d "$STATE" ] || return 0
    rm -f "$STATE/restored" || return 1
    old_boot=$(cat "$STATE/boot-id" 2>/dev/null || true)
    current_boot=$(cat "$BOOT_ID" 2>/dev/null || true)
    if [ "$old_boot" != "$current_boot" ]; then
        # A reboot or firmware update invalidates the ephemeral LAN snapshot.
        # Do not replay it onto a possibly replaced /etc/config/dhcp.
        rm -rf "$STATE"
        return 0
    fi
    # Remove only DNS entries absent before activation.
    if ! [ -e "$STATE/gateway-dns-present" ]; then
        uci -q del_list "dhcp.@dnsmasq[0].server=$DNS_GATEWAY" || true
    fi
    if [ -e "$STATE/daemon-dns-present" ] && ! has_dns "$DNS_DAEMON"; then
        uci add_list "dhcp.@dnsmasq[0].server=$DNS_DAEMON" || return 1
    fi
    uci commit dhcp || return 1
    "$ODHCPD" restart || return 1
    "$DNSMASQ" restart || return 1
    if [ "$old_boot" = "$current_boot" ] && [ -s "$STATE/forwarding" ]; then
        sysctl -w "net.ipv6.conf.all.forwarding=$(cat "$STATE/forwarding")" >/dev/null || return 1
    fi
    if [ "$old_boot" = "$current_boot" ] && [ -s "$STATE/proxy-ndp" ]; then
        sysctl -w "net.ipv6.conf.all.proxy_ndp=$(cat "$STATE/proxy-ndp")" >/dev/null || return 1
    fi
    : > "$STATE/restored"
}

service_stopped() {
    [ -d "$STATE" ] || return 0
    # Keep the alias and snapshot if restoring DNS or sysctl failed. The
    # route sender needs its source address while SIGTERM triggers withdrawal.
    [ -e "$STATE/restored" ] || return 1
    attempts=0
    while [ "$attempts" -lt 7 ]; do
        instances=$(ubus call service list '{"name":"fips-gateway"}') || return 1
        case "$instances" in \{*\}) ;; *) return 1;; esac
        route_running=$(printf '%s\n' "$instances" | jsonfilter -e "@['fips-gateway'].instances.route.running" 2>/dev/null || true)
        [ "$route_running" = true ] || break
        attempts=$((attempts + 1))
        sleep 1
    done
    [ "$route_running" != true ] || return 1
    if [ -s "$STATE/ra-address" ]; then
        ra_source=$(cat "$STATE/ra-address") || return 1
        if ip -6 -o addr show dev br-lan scope link | grep -Fq " $ra_source/64 "; then
            ip -6 addr del "$ra_source/64" dev br-lan || return 1
        fi
    fi
    rm -rf "$STATE"
}

reload_service() {
    restart
}
