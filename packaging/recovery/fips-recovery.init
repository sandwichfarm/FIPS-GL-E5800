#!/bin/sh /etc/rc.common
# Install as /etc/init.d/fips-recovery before starting a deployment.
USE_PROCD=1
START=05
STOP=95

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /etc/fips-recovery/guard.sh watch
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
