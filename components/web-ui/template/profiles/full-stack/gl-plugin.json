{
  "$schema": "https://raw.githubusercontent.com/go-wombat/gl-sdk4-plugin-kit/main/schema/gl-plugin.schema.json",
  "schemaVersion": 1,
  "id": "__PLUGIN_ID__",
  "profile": "full-stack",
  "compatibility": {
    "minimumFirmware": "4.8.0",
    "requiredComponents": [
      "gl-button",
      "gl-card",
      "gl-tips",
      "gl-title"
    ],
    "requiredCapabilities": []
  },
  "package": {
    "name": "gl-sdk4-ui-__PLUGIN_ID__",
    "architecture": "all",
    "section": "base",
    "depends": [
      "libc",
      "gl-sdk4-ui-core",
      "gl-oui-rpc",
      "ubus",
      "jsonfilter",
      "uci"
    ],
    "conffiles": [
      "/etc/config/__PLUGIN_ID__"
    ]
  },
  "overlay": "overlay",
  "lifecycle": {
    "postinst": "hooks/postinst",
    "prerm": "hooks/prerm"
  }
}
