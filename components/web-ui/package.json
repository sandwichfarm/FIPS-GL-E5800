{
  "name": "gl-sdk4-plugin-kit",
  "version": "0.9.0",
  "description": "Unofficial toolkit for building native GL.iNet router admin panel plugins",
  "keywords": [
    "gl-inet",
    "openwrt",
    "router",
    "plugin",
    "sdk4",
    "vue"
  ],
  "author": "go-wombat",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./browser": {
      "types": "./browser.d.ts",
      "require": "./lib/api.js",
      "default": "./lib/api.js"
    },
    "./chart": {
      "types": "./runtime/chart.d.ts",
      "require": "./runtime/chart.js",
      "default": "./runtime/chart.js"
    },
    "./admin-session": {
      "types": "./runtime/admin-session.d.ts",
      "require": "./runtime/admin-session.js",
      "default": "./runtime/admin-session.js"
    },
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./runtime/*.js": "./runtime/*.js",
    "./runtime/*.css": "./runtime/*.css",
    "./runtime/*": "./runtime/*.js",
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "generate:types": "node scripts/generate-api-types.js",
    "check:types": "node scripts/generate-api-types.js --check",
    "prepack": "npm run check:types && npm test"
  },
  "bin": {
    "glplugin": "bin/glplugin"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "rpc-api.d.ts",
    "browser.d.ts",
    "bin/",
    "scripts/generate-api-types.js",
    "lib/",
    "runtime/",
    "template/",
    "examples/",
    "docs/",
    "schema/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/go-wombat/gl-sdk4-plugin-kit.git"
  },
  "bugs": {
    "url": "https://github.com/go-wombat/gl-sdk4-plugin-kit/issues"
  },
  "homepage": "https://github.com/go-wombat/gl-sdk4-plugin-kit#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "typescript": "^7.0.2",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "overrides": {
    "@vue/component-compiler-utils": {
      "postcss": "^8.5.23"
    }
  }
}
